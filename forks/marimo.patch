+++ b/frontend/src/core/tutor/debug.ts
@@ -0,0 +1,53 @@
+/* Copyright 2026 Marimo. All rights reserved. */
+import { z } from "zod";
+import { getTutorConnection } from "./connection";
+
+const payload = z.object({
+  text: z.string().max(32000),
+  truncated: z.boolean(),
+});
+const event = payload.extend({
+  sequence: z.number(),
+  at: z.string(),
+  direction: z.string(),
+  method: z.string(),
+  kind: z.string().nullable(),
+  requestId: z.string().nullable(),
+});
+const debugSchema = z.object({
+  notebook: z.string(),
+  connected: z.boolean(),
+  paused: z.boolean(),
+  dropped: z.number(),
+  instructions: payload,
+  events: z.array(event).max(200),
+  latestPrompt: event.nullable(),
+  configuration: payload.nullable(),
+});
+export type TutorDebug = z.infer<typeof debugSchema>;
+
+export async function fetchTutorDebug(
+  action?: "pause" | "resume" | "clear",
+  signal?: AbortSignal,
+) {
+  const connection = getTutorConnection();
+  if (!connection) {
+    throw new Error("Launch with make tutor-start to inspect the tutor.");
+  }
+  const response = await fetch(
+    `${connection.url}/debug${action ? `/${action}` : ""}`,
+    {
+      method: action ? "POST" : "GET",
+      headers: { Authorization: `Bearer ${connection.token}` },
+      signal: signal
+        ? AbortSignal.any([signal, AbortSignal.timeout(5000)])
+        : AbortSignal.timeout(5000),
+    },
+  );
+  if (!response.ok) {
+    throw new Error(
+      `Tutor diagnostics unavailable (HTTP ${response.status}). Restart the tutor launcher if needed.`,
+    );
+  }
+  return debugSchema.parse(await response.json());
+}
