+    phase: z.enum(["planning", "approved", "complete"]),
+    planId: z.string().nullable(),
+    goal: z.string().max(1000).nullable(),
+    prerequisites: z.string().max(1500),
+    outline: z.array(z.string().max(500)).max(6),
+  })
+  .nullable();
+export type LearningPlan = z.infer<typeof learningSchema>;
+
+export async function fetchLearning(planId?: string, signal?: AbortSignal) {
+  const connection = getTutorConnection();
+  if (!connection) throw new Error("Open this notebook with zen.");
+  const response = await fetch(
+    `${connection.url}/learning${planId ? "/approve" : ""}`,
+    {
+      method: planId ? "POST" : "GET",
+      redirect: "error",
+      headers: {
+        Authorization: `Bearer ${connection.token}`,
+        "Content-Type": "application/json",
+      },
+      body: planId ? JSON.stringify({ planId }) : undefined,
+      signal: signal
+        ? AbortSignal.any([signal, AbortSignal.timeout(5000)])
+        : AbortSignal.timeout(5000),
+    },
+  );
+  if (!response.ok)
+    throw new Error(
+      `Learning setup unavailable (HTTP ${response.status}). Refresh the plan or reopen the agent panel.`,
+    );
+  return learningSchema.parse(await response.json());
+}
