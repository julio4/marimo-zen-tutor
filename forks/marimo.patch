@@ -0,0 +1,64 @@
+/* Copyright 2026 Marimo. All rights reserved. */
+
+import type { EditorView } from "@codemirror/view";
+import { useAtom } from "jotai";
+import { LightbulbIcon } from "lucide-react";
+import { useState } from "react";
+import { toast } from "@/components/ui/use-toast";
+import { pendingAiPromptAtom } from "@/core/ai/state";
+import { getNotebook } from "@/core/cells/cells";
+import type { CellId } from "@/core/cells/ids";
+import { getEditorCodeAsPython } from "@/core/codemirror/language/utils";
+import { createTutorHelpPrompt } from "@/core/tutor/help";
+import { ToolbarItem } from "./toolbar";
+
+export function TutorHelp({
+  cellId,
+  getEditorView,
+}: {
+  cellId: CellId;
+  getEditorView: () => EditorView | null;
+}) {
+  const [pending, setPending] = useAtom(pendingAiPromptAtom);
+  const [preparing, setPreparing] = useState(false);
+  const help = async () => {
+    setPreparing(true);
+    try {
+      const notebook = getNotebook();
+      const cell = notebook.cellData[cellId];
+      if (!cell) {
+        throw new Error("This cell no longer exists.");
+      }
+      const view = getEditorView();
+      const draft = view ? getEditorCodeAsPython(view) : cell.code;
+      const prompt = await createTutorHelpPrompt(
+        cell,
+        notebook.cellRuntime[cellId],
+        draft,
+      );
+      setPending({ prompt, submit: true });
+      toast({
+        title: "Hint requested",
+        description: "Your tutor is working in the background.",
+      });
+    } catch (error) {
+      toast({
+        title: "Could not request help",
+        description: String(error),
+        variant: "danger",
+      });
+    } finally {
+      setPreparing(false);
+    }
+  };
+  return (
+    <ToolbarItem
+      aria-label="Help me think"
+      tooltip="Help me think — sends this draft and prior output to your tutor"
+      disabled={preparing || pending !== null}
+      onClick={() => void help()}
+    >
+      <LightbulbIcon />
+    </ToolbarItem>
+  );
+}
diff --git a/frontend/src/components/editor/chrome/panels/tutor-panel.tsx b/frontend/src/components/editor/chrome/panels/tutor-panel.tsx
new file mode 100644
index 0000000..2f20bb3
--- /dev/null
+++ b/frontend/src/components/editor/chrome/panels/tutor-panel.tsx
@@ -0,0 +1,178 @@
+/* Copyright 2026 Marimo. All rights reserved. */
+import { useEffect, useState } from "react";
+import { Button } from "@/components/ui/button";
+import { fetchTutorDebug, type TutorDebug } from "@/core/tutor/debug";
+
+function Payload({ value }: { value: { text: string; truncated: boolean } }) {
+  let text = value.text;
+  try {
+    const parsed: unknown = JSON.parse(text);
+    text =
+      typeof parsed === "string" ? parsed : JSON.stringify(parsed, null, 2);
+  } catch {
+    /* Truncated JSON stays readable as text. */
+  }
+  return (
+    <>
+      {value.truncated && <p>Truncated to 32,000 characters.</p>}
+      <pre className="text-xs whitespace-pre-wrap break-words max-h-64 overflow-auto p-2 bg-muted rounded">
+        {text}
+      </pre>
+    </>
+  );
+}
+
+export default function TutorPanel() {
+  const [data, setData] = useState<TutorDebug | null>(null);
+  const [error, setError] = useState("");
+  const [busy, setBusy] = useState(false);
+  useEffect(() => {
+    const controller = new AbortController();
+    let timer: ReturnType<typeof setTimeout>;
+    const poll = async () => {
+      try {
+        const next = await fetchTutorDebug(undefined, controller.signal);
+        setData(next);
+        setError("");
+      } catch (error) {
+        if (!controller.signal.aborted) {
+          setError(String(error));
+        }
+      }
+      if (!controller.signal.aborted) {
+        timer = setTimeout(poll, 1000);
+      }
+    };
+    void poll();
+    return () => {
+      controller.abort();
+      clearTimeout(timer);
+    };
+  }, []);
+  const control = async (action: "pause" | "resume" | "clear") => {
+    setBusy(true);
+    try {
+      setData(await fetchTutorDebug(action));
+      setError("");
+    } catch (error) {
+      setError(String(error));
+    } finally {
+      setBusy(false);
+    }
+  };
+  const exportSnapshot = () => {
+    if (
+      !data ||
+      !window.confirm(
+        "Export contains notebook code, outputs and conversation text. Redaction is best-effort; review before sharing. Export this snapshot?",
+      )
+    ) {
+      return;
+    }
+    const url = URL.createObjectURL(
+      new Blob([JSON.stringify(data, null, 2)], { type: "application/json" }),
+    );
+    const link = document.createElement("a");
+    link.href = url;
+    link.download = "tutor-debug.json";
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  };
+  return (
+    <section
+      aria-label="Tutor diagnostics"
+      className="p-3 space-y-3 text-sm overflow-auto h-full"
+    >
+      <div className="flex items-center gap-2 flex-wrap">
+        <strong>Tutor diagnostics</strong>
+        <span>
+          {data
+            ? `${data.connected ? "Connected" : "Disconnected"} · ${data.paused ? "Capture paused" : "Capturing"}`
+            : "Connecting…"}
+        </span>
+        <Button
+          size="xs"
+          variant="outline"
+          disabled={!data || busy}
+          onClick={() => void control(data?.paused ? "resume" : "pause")}
+        >
+          {data?.paused ? "Enable capture" : "Pause capture"}
+        </Button>
+        <Button
+          size="xs"
+          variant="outline"
+          disabled={!data || busy}
+          onClick={() => void control("clear")}
+        >
+          Clear diagnostics
+        </Button>
+        <Button
+          size="xs"
+          variant="outline"
+          disabled={!data}
+          onClick={exportSnapshot}
+        >
+          Export diagnostics
+        </Button>
+      </div>
+      {error && <p role="alert">{error} Displayed data may be stale.</p>}
+      <p className="text-muted-foreground">
+        Broker-observed ACP traffic, not the full provider request or hidden
+        reasoning. Redaction is best-effort. Memory only: last 200 events / 1
+        million payload characters; {data?.dropped ?? 0} older events dropped.
+        Capture is off on launch. Enable it to record future events; earlier
+        interactions are not backfilled. Pause/clear affect diagnostics only,
+        not tutoring or saved conversations.
+      </p>
+      <p>
+        Learning context: companion, learner profile, inferred goals and passive
+        edit/run/time tracking are not implemented. Help requests contain the
+        selected draft and prior output.
+      </p>
+      {data && (
+        <>
+          <p className="break-all">Notebook: {data.notebook}</p>
+          <details>
+            <summary className="cursor-pointer">
+              Bundled teaching instructions (launcher startup)
+            </summary>
+            <Payload value={data.instructions} />
+          </details>
+          <details>
+            <summary className="cursor-pointer">
+              Latest observed session/model/thinking configuration
+            </summary>
+            {data.configuration ? (
+              <Payload value={data.configuration} />
+            ) : (
+              <p>No configuration captured yet. Connect or resume the agent.</p>
+            )}
+          </details>
+          <details>
+            <summary className="cursor-pointer">
+              Latest submitted context
+            </summary>
+            {data.latestPrompt ? (
+              <Payload value={data.latestPrompt} />
+            ) : (
+              <p>No prompt captured yet.</p>
+            )}
+          </details>
+          <h3 className="font-semibold">Event timeline</h3>
+          {data.events.length === 0 && <p>No events retained.</p>}
+          {data.events.toReversed().map((event) => (
+            <details key={event.sequence} className="border-b py-1">
+              <summary className="cursor-pointer font-mono text-xs">
+                #{event.sequence} {event.at} · {event.direction} ·{" "}
+                {event.method}
+                {event.kind && ` · ${event.kind}`}
+                {event.requestId !== null && ` · request ${event.requestId}`}
+              </summary>
+              <Payload value={event} />
+            </details>
+          ))}
+        </>
+      )}
+    </section>
+  );
+}
