+    lastRunSource: { text: "mean = 7.5", truncated: false },
+    draftNotRun: true,
+    draftRevision: expect.stringMatching(/^[a-f0-9]{64}$/),
+    outputFromPreviousExecution: null,
+  });
+  expect(cell.code).toBe("old");
+  const large = await createTutorHelpPrompt(cell, runtime, "x".repeat(25_000));
