@@ -0,0 +1,136 @@
+/* Copyright 2026 Marimo. All rights reserved. */
+import { useAtom, useAtomValue } from "jotai";
+import { useEffect, useState } from "react";
+import { AgentThread } from "@/components/chat/acp/thread";
+import { Button } from "@/components/ui/button";
+import { pendingAiPromptAtom } from "@/core/ai/state";
+import {
+  fetchLearning,
+  type LearningPlan,
+  tutorConversationAtom,
+} from "./learning";
+
+export default function TutorOnboarding() {
+  const conversation = useAtomValue(tutorConversationAtom);
+  const [pending, setPending] = useAtom(pendingAiPromptAtom);
+  const [message, setMessage] = useState("");
+  const [plan, setPlan] = useState<LearningPlan>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [approving, setApproving] = useState(false);
+  useEffect(() => {
+    const controller = new AbortController();
+    let timer: ReturnType<typeof setTimeout>;
+    const poll = async () => {
+      try {
+        const next = await fetchLearning(undefined, controller.signal);
+        if (!controller.signal.aborted) {
+          setPlan(next);
+          setError(null);
+        }
+      } catch (error) {
+        if (!controller.signal.aborted) setError(String(error));
+      }
+      if (!controller.signal.aborted) timer = setTimeout(poll, 1000);
+    };
+    void poll();
+    return () => {
+      controller.abort();
+      clearTimeout(timer);
+    };
+  }, []);
+  const busy = conversation.busy || pending !== null || approving;
+  const start = async () => {
+    if (!plan?.planId) return;
+    setApproving(true);
+    try {
+      const approved =
+        plan.phase === "approved" ? plan : await fetchLearning(plan.planId);
+      if (!approved || approved.phase !== "approved")
+        throw new Error("Review the current plan before continuing.");
+      setPlan(approved);
+      setPending({
+        prompt: `I approved learning plan ${approved.planId} using Start learning. Goal: ${approved.goal}. Inspect the notebook and generate the approved learning notebook now, preserving my cells.`,
+        submit: true,
+      });
+    } catch (error) {
+      setError(String(error));
+    } finally {
+      setApproving(false);
+    }
+  };
+  return (
+    <section
+      aria-label="Learning setup"
+      className="rounded-lg border border-border bg-background p-4 space-y-4"
+    >
+      <h2 className="text-lg font-semibold">What would you like to learn?</h2>
+      <p className="text-sm text-muted-foreground">
+        Tell your tutor your goal, what you already know, and how much time you
+        have. Nothing is generated until you approve a plan.
+      </p>
+      <div
+        className="max-h-96 overflow-auto text-sm"
+        aria-label="Learning conversation"
+      >
+        <AgentThread
+          notifications={conversation.notifications}
+          isConnected={conversation.ready}
+        />
+      </div>
+      {(error || conversation.error) && (
+        <p role="alert">{error || conversation.error}</p>
+      )}
+      <form
+        className="flex flex-col gap-2"
+        onSubmit={(event) => {
+          event.preventDefault();
+          if (!message.trim() || busy || !plan) return;
+          setPending({ prompt: message.trim(), submit: true });
+          setMessage("");
+        }}
+      >
+        <textarea
+          aria-label="Your learning goal"
+          className="w-full rounded border bg-background p-2 text-sm"
+          rows={3}
+          maxLength={4000}
+          value={message}
+          onChange={(event) => setMessage(event.target.value)}
+          placeholder="I'd like to understand probability, starting with coin flips…"
+          disabled={busy}
+        />
+        <Button type="submit" disabled={busy || !message.trim() || !plan}>
+          Send
+        </Button>
+        {busy && (
+          <p role="status" className="text-sm text-muted-foreground">
+            Your tutor is working…
+          </p>
+        )}
+      </form>
+      {plan?.goal && (
+        <div className="rounded border p-3 space-y-2">
+          <h3 className="font-semibold">Proposed goal: {plan.goal}</h3>
+          <p className="text-sm">
+            Starting point: {plan.prerequisites || "No prerequisites specified"}
+          </p>
+          <ol className="list-decimal pl-5 text-sm">
+            {plan.outline.map((step, index) => (
+              <li key={index}>{step}</li>
+            ))}
+          </ol>
+          <p className="text-sm text-muted-foreground">
+            You can ask for changes before approving. Starting replaces only
+            this setup block; the conversation stays in your agent history.
+          </p>
+          <Button
+            onClick={() => void start()}
+            disabled={busy || plan.phase === "complete"}
+          >
+            {plan.phase === "approved" ? "Create notebook" : "Start learning"}
+          </Button>
+        </div>
+      )}
+    </section>
+  );
+}
