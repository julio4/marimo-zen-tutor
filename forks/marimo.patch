--- /dev/null
+++ b/frontend/src/core/tutor/connection.ts
@@ -0,0 +1,68 @@
+/* Copyright 2026 Marimo. All rights reserved. */
+
+import { z } from "zod";
+
+export function getTutorConnection() {
+  if (typeof window === "undefined") {
+    return null;
+  }
+  const params = new URLSearchParams(window.location.hash.slice(1));
+  const token = params.get("zen");
+  const port = Number(params.get("zenPort"));
+  if (
+    !token ||
+    !/^[a-f0-9]{64}$/.test(token) ||
+    !Number.isInteger(port) ||
+    port < 1 ||
+    port > 65535 ||
+    window.location.hostname !== "127.0.0.1"
+  ) {
+    return null;
+  }
+  return { url: `http://127.0.0.1:${port}`, token };
+}
+
+export function isTutorOnboarding() {
+  return !!getTutorConnection() && new URLSearchParams(window.location.hash.slice(1)).get("zenInit") === "1";
+}
+
+export async function getTutorSessions(notebook: string) {
+  const connection = getTutorConnection();
+  if (!connection) {
+    throw new Error("Launch this notebook with make tutor-start.");
+  }
+  const response = await fetch(`${connection.url}/sessions`, {
+    headers: { Authorization: `Bearer ${connection.token}` },
+    signal: AbortSignal.timeout(10_000),
+  });
+  if (!response.ok) {
+    throw new Error(
+      "Cannot load tutor sessions. Reconnect to retry; no new session was created.",
+    );
+  }
+  const data = z
+    .object({
+      notebook: z.string(),
+      sessions: z.array(z.object({ id: z.string(), updatedAt: z.string() })),
+    })
+    .parse(await response.json());
+  if (data.notebook !== notebook) {
+    throw new Error("The tutor is attached to a different notebook.");
+  }
+  return data.sessions;
+}
+
+export async function initializeTutorNotebook() {
+  const connection = getTutorConnection();
+  if (!connection) {
+    throw new Error("Launch this notebook with make tutor-start.");
+  }
+  const response = await fetch(`${connection.url}/initialize`, {
+    method: "POST",
+    headers: { Authorization: `Bearer ${connection.token}` },
+    signal: AbortSignal.timeout(30_000),
+  });
+  if (!response.ok) {
+    throw new Error(await response.text());
+  }
+}
