+/* Copyright 2026 Marimo. All rights reserved. */
+
+import { createStore } from "jotai";
+import { afterEach, expect, it, vi } from "vitest";
+import { aiCompletionCellAtom } from "@/core/ai/state";
+import { CellId } from "@/core/cells/ids";
+import { requestEditCompletion } from "@/core/codemirror/ai/request";
+import { copilotBundle } from "@/core/codemirror/copilot/extension";
+import {
+  isAiEnabled,
+  isAiFeatureEnabled,
+  resolvedMarimoConfigAtom,
+  userConfigAtom,
+} from "@/core/config/config";
+import { defaultUserConfig } from "@/core/config/config-schema";
+import { resolveAiPanelTab } from "@/components/editor/chrome/wrapper/useOpenAiAssistant";
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.unstubAllEnvs();
+});
+
+it("blocks generative entry points in tutor mode without changing saved settings", async () => {
+  vi.stubGlobal("window", {
+    location: {
+      hostname: "127.0.0.1",
+      hash: `#zen=${"a".repeat(64)}&zenPort=3027`,
+    },
+  });
+  const store = createStore();
+  const config = defaultUserConfig();
+  config.ai = {
+    enabled: true,
+    models: {
+      chat_model: "test/model",
+      custom_models: [],
+      displayed_models: [],
+    },
+  };
+  config.completion.copilot = "github";
+  store.set(userConfigAtom, config);
+  expect(isAiEnabled(config)).toBe(true); // Tutor panel stays available.
+  expect(isAiFeatureEnabled(config)).toBe(false);
+  expect(isAiEnabled({ ...config, ai: { ...config.ai, enabled: false } })).toBe(
+    true,
+  );
+  expect(store.get(resolvedMarimoConfigAtom).completion.copilot).toBe(false);
+  expect(store.get(userConfigAtom).completion.copilot).toBe("github");
+  expect(resolveAiPanelTab("chat", "chat")).toBe("agents");
+  store.set(aiCompletionCellAtom, { cellId: CellId.create() });
+  expect(store.get(aiCompletionCellAtom)).toBeNull();
+  const rewrite = () =>
+    requestEditCompletion({
+      prompt: "solve",
+      selection: "x",
+      codeBefore: "",
+      codeAfter: "",
+      language: "python",
+    });
+  await expect(rewrite()).rejects.toThrow("disabled in tutor mode");
+  vi.stubEnv("NODE_ENV", "production");
+  for (const copilot of ["github", "codeium", "custom"] as const) {
+    expect(copilotBundle({ ...config.completion, copilot })).toEqual([]);
+  }
+  vi.stubGlobal("window", { location: { hostname: "127.0.0.1", hash: "" } });
+  expect(isAiFeatureEnabled(config)).toBe(true);
+  expect(isAiEnabled({ ...config, ai: { ...config.ai, enabled: false } })).toBe(
+    false,
+  );
+  expect(resolveAiPanelTab("chat", "agents")).toBe("chat");
+  const target = { cellId: CellId.create() };
+  store.set(aiCompletionCellAtom, () => target);
+  expect(store.get(aiCompletionCellAtom)).toEqual(target);
+});
